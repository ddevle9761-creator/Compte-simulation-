# Exemple de variables d'environnement pour la configuration SMTP
# Copiez ce fichier en `.env` et remplissez vos valeurs locales.

# Adresse e-mail utilisée pour l'envoi
SMTP_EMAIL=your-smtp-email@example.com
# Mot de passe ou token d'application (ne commitez jamais ce fichier avec la vraie valeur)
SMTP_PASSWORD=your-smtp-password-or-token
# Serveur SMTP (par défaut Gmail)
SMTP_SERVER=smtp.gmail.com
# Port SMTP (par défaut 587)
SMTP_PORT=587

# Optionnel: chemin vers le fichier data (par défaut `data/`)
#DATA_DIR=data
